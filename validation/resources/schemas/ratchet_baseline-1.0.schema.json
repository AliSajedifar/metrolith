{
  "$id": "https://archlens.dev/schemas/ratchet_baseline-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchLens Ratchet Baseline Contract 1.0.0",
  "description": "Canonical capture-only Ratchet baseline binding authoritative producer-run bytes, producer identity, measurement semantics, complete coordinates, and persisted observations.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "version_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "format": {
      "const": "archlens-ratchet-baseline"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "run_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "analysis_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_version": {
          "$ref": "#/$defs/semver"
        },
        "status": {
          "const": "complete"
        },
        "admitted": {
          "const": true
        }
      },
      "required": [
        "run_id",
        "run_manifest_sha256",
        "analysis_sha256",
        "producer_version",
        "status",
        "admitted"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program_name": {
          "type": "string",
          "minLength": 1
        },
        "program_version": {
          "$ref": "#/$defs/semver"
        },
        "evaluator_source_identity": {
          "type": "string",
          "pattern": "^(git:[0-9a-f]{40,64}:(clean|dirty)|sha256:[0-9a-f]{64})$"
        },
        "metric_contract_version": {
          "$ref": "#/$defs/semver"
        },
        "complexity_contract_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "program_name",
        "program_version",
        "evaluator_source_identity",
        "metric_contract_version",
        "complexity_contract_version"
      ]
    },
    "measurement_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fingerprint_version": {
          "const": "1.0.0"
        },
        "fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metric_contract_version": {
          "$ref": "#/$defs/semver"
        },
        "complexity_contract_version": {
          "$ref": "#/$defs/semver"
        },
        "exclusion_policy_version": {
          "$ref": "#/$defs/semver"
        },
        "exclusion_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effective_exclusion_configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parser_configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metric_options_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "grammar_versions": {
          "$ref": "#/$defs/version_map"
        },
        "runtime_versions": {
          "$ref": "#/$defs/version_map"
        }
      },
      "required": [
        "fingerprint_version",
        "fingerprint_sha256",
        "metric_contract_version",
        "complexity_contract_version",
        "exclusion_policy_version",
        "exclusion_policy_sha256",
        "effective_exclusion_configuration_sha256",
        "parser_configuration_sha256",
        "metric_options_sha256",
        "grammar_versions",
        "runtime_versions"
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_key": {
            "type": "string",
            "minLength": 1
          },
          "subject_key_basis": {
            "type": "string",
            "minLength": 1
          },
          "analyzed_commit_sha": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "artifact_schema_version": {
            "$ref": "#/$defs/semver"
          },
          "metric_contracts": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/semver"
            }
          },
          "analysis_scope_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "analysis_scope_hash_version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "subject_key",
          "subject_key_basis",
          "analyzed_commit_sha",
          "artifact_schema_version",
          "metric_contracts",
          "analysis_scope_hash",
          "analysis_scope_hash_version"
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ratchet\\.[a-z0-9_.:-]+$"
          },
          "metric": {
            "type": "string",
            "pattern": "^(repository|language)\\.[a-z][a-z0-9_]*$"
          },
          "metric_contract": {
            "enum": [
              "metrics",
              "complexity"
            ]
          },
          "scope": {
            "enum": [
              "repository",
              "language"
            ]
          },
          "direction": {
            "enum": [
              "increase_is_worse",
              "decrease_is_worse"
            ]
          },
          "max_regression": {
            "type": "number",
            "minimum": 0
          },
          "severity": {
            "enum": [
              "violation",
              "warning",
              "info"
            ]
          }
        },
        "required": [
          "rule_id",
          "metric",
          "metric_contract",
          "scope",
          "direction",
          "max_regression",
          "severity"
        ]
      }
    },
    "coordinate_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ratchet\\.[a-z0-9_.:-]+$"
          },
          "subject_key": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "oneOf": [
              {
                "$ref": "#/$defs/language"
              },
              {
                "type": "null"
              }
            ]
          },
          "metric": {
            "type": "string",
            "pattern": "^(repository|language)\\.[a-z][a-z0-9_]*$"
          },
          "scope": {
            "enum": [
              "repository",
              "language"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "intentional_exclusion",
              "not_applicable",
              "unavailable"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "source_artifact": {
            "enum": [
              "analysis.json",
              "callables-ledger"
            ]
          },
          "source_artifact_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "rule_id",
          "subject_key",
          "language",
          "metric",
          "scope",
          "status",
          "required",
          "source_artifact",
          "source_artifact_sha256"
        ]
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ratchet\\.[a-z0-9_.:-]+$"
          },
          "subject_key": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "oneOf": [
              {
                "$ref": "#/$defs/language"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_value": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "rule_id",
          "subject_key",
          "language",
          "baseline_value"
        ]
      }
    }
  },
  "required": [
    "format",
    "format_version",
    "source_run",
    "producer",
    "measurement_semantics",
    "subjects",
    "rules",
    "coordinate_manifest",
    "observations"
  ]
}
