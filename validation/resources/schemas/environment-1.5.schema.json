{
  "$id": "https://archlens.dev/schemas/environment-1.5.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Authoritative recorded execution environment (plan section 4.1). Property types are derived from preserved Artifact 1.4 runs. additionalProperties stays true because three runs of thirteen repositories prove which fields exist, not that no other field may appear.",
  "properties": {
    "archlens_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "artifact_schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "effective_git_checkout_configuration": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "exclusion_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "exclusion_policy_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "git_version": {
      "type": "string"
    },
    "grammar_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "inventory_schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "metric_contract_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "operating_system": {
      "type": "string"
    },
    "package_distribution_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "parser_initialization": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "platform": {
      "type": "string"
    },
    "profiler_git_commit_sha": {
      "description": "Null when the profiler has no immutable Git revision. A null value makes reproduce's exact_environment_ready state impossible (plan 16.2); it must never be replaced by a guess.",
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "profiler_git_dirty": {
      "type": "boolean"
    },
    "profiler_git_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "python_version": {
      "type": "string"
    },
    "python_version_exact": {
      "type": "string"
    },
    "tree_sitter_version": {
      "type": "string"
    }
  },
  "required": [
    "archlens_version",
    "artifact_schema_version",
    "exclusion_policy_version",
    "git_version",
    "inventory_schema_version",
    "metric_contract_version",
    "operating_system",
    "platform",
    "python_version"
  ],
  "title": "ArchLens environment 1.5",
  "type": "object"
}
