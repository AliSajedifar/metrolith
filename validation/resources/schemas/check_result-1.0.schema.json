{
  "$defs": {
    "finding": {
      "additionalProperties": false,
      "description": "One deterministic finding. It carries everything a consumer needs without re-evaluating the policy or re-reading the run, so a later SARIF writer is a projection of this record rather than a second evaluator.\n\nOnly `violated`, `not_evaluable`, `not_applicable` and `evaluation_error` produce findings. A pass is counted and never enumerated: one row per passing callable would be megabytes of output saying nothing is wrong. Pass counts are in `counts.units` and per rule in `rules[]`.",
      "properties": {
        "callable_qualified_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "callable_row_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_completeness": {
          "$ref": "#/$defs/completeness"
        },
        "domain": {
          "description": "The Policy v1 domain, for integrity findings only.",
          "type": [
            "string",
            "null"
          ]
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "description": "Extra evidence only: the v1 rule's evidence for an integrity finding, or the collapsed row counts for a callable-scope non-evaluability. Never a copy of the analysis.",
          "type": "object"
        },
        "finding_id": {
          "description": "Deterministic identity, digested from the rule id, the metric, the scope and the location and NOTHING else. Not a timestamp, not a UUID, not an array position, and deliberately not the observed value or the threshold: the same problem keeps one identity as the number drifts, and re-tuning a threshold does not orphan a finding's history.",
          "pattern": "^alf1:[0-9a-f]{32}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "integrity",
            "metric"
          ]
        },
        "language": {
          "description": "The language exactly as the artifact recorded it. The producer spells core metrics lowercase and complexity in display case; matching is case-insensitive and identity casefolds, so one language never yields two findings.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "A deterministic sentence. A `not_evaluable` message states that the rule did NOT run; it never reads as a pass.",
          "minLength": 1,
          "type": "string"
        },
        "metric": {
          "description": "Null for an integrity finding: a v1 rule is a predicate over the measurement process, not a comparison against a number, and filling this with a placeholder would invent a threshold where the point is that none exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "observed_value": {
          "description": "The persisted measurement, or null when the rule could not be evaluated. A null here is UNAVAILABLE and is never read as zero.",
          "type": [
            "number",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator_symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "POSIX-normalized relative path, for callable-scope findings.",
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "description": "What a reader needs to know the number's meaning: run id and the contract versions it was measured under, plus the analyzed scope for a subject-bound finding.",
          "type": "object"
        },
        "reason": {
          "description": "Typed reason, present whenever the status is not `violated`, so a consumer never parses the message to learn why.",
          "type": [
            "string",
            "null"
          ]
        },
        "repository_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "enum": [
            "run",
            "repository",
            "language",
            "callable"
          ]
        },
        "severity": {
          "enum": [
            "violation",
            "warning",
            "info"
          ]
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "subject_key": {
          "description": "Empty for a run-wide integrity fact that names no subject.",
          "type": "string"
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_status": {
          "description": "The persisted status that gated the read, verbatim. `metric_status` itself is never modified by policy evaluation.",
          "type": [
            "string",
            "null"
          ]
        },
        "value_status_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "waiver": {
          "$ref": "#/$defs/waiver"
        }
      },
      "required": [
        "data_completeness",
        "domain",
        "evidence",
        "finding_id",
        "kind",
        "language",
        "message",
        "metric",
        "observed_value",
        "operator",
        "operator_symbol",
        "path",
        "provenance",
        "reason",
        "repository_url",
        "rule_id",
        "scope",
        "severity",
        "status",
        "subject_key",
        "threshold",
        "value_status",
        "value_status_field"
      ],
      "type": "object"
    },
    "completeness": {
      "description": "What the observed value is worth, derived from the persisted status and never written back to it. `not_applicable` (nothing of this kind to measure) is deliberately distinct from `unavailable` (a gap) and from `absent` (this artifact generation recorded nothing of this kind at all).",
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "not_applicable",
        "absent"
      ]
    },
    "outcomeCounts": {
      "additionalProperties": false,
      "properties": {
        "evaluation_error": {
          "minimum": 0,
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "type": "integer"
        },
        "not_evaluable": {
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "units_evaluated": {
          "minimum": 0,
          "type": "integer"
        },
        "violated": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "evaluation_error",
        "not_applicable",
        "not_evaluable",
        "passed",
        "units_evaluated",
        "violated"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "violated",
        "passed",
        "not_evaluable",
        "not_applicable",
        "evaluation_error"
      ]
    },
    "waiver": {
      "additionalProperties": false,
      "properties": {
        "expires_on": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "issue_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        },
        "subject_key": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "expires_on",
        "reason",
        "rule_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://archlens.dev/schemas/check_result-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The machine-readable outcome of `archlens check`: one run bundle evaluated against one policy document. A DERIVED, explicitly non-authoritative output with its own format version; it is never measurement evidence and is never read back as one.\n\nEVERY THRESHOLD HERE IS USER-SUPPLIED POLICY. No value in this document is a research finding or an architecture-quality claim.\n\nTHE VERDICT NEVER LAUNDERS A GAP INTO A PASS. A rule whose measurement was unavailable is reported `not_evaluable` and is listed separately, and under the default `options.on_not_evaluable` it fails the build. A rule whose scope had nothing to measure is `not_applicable` and never fails. The two are never merged.\n\nThis document is emitted for a failed evaluation too, with `verdict: error` and a `failure_kind`, so a CI step parsing the output never has to tell \"no document\" apart from \"clean pass\".",
  "properties": {
    "archlens_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "check_result_format_version": {
      "const": "1.0.0"
    },
    "completeness_meanings": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "by_severity": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Over emitted findings.",
          "type": "object"
        },
        "by_status": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Over emitted findings. `passed` is always 0 here, because a pass is never enumerated; the honest pass count is in `units`.",
          "type": "object"
        },
        "failing": {
          "description": "Findings that require exit 1: violation-severity rules that fired, plus violation-severity rules that could not run when options.on_not_evaluable is `fail`.",
          "minimum": 0,
          "type": "integer"
        },
        "findings": {
          "minimum": 0,
          "type": "integer"
        },
        "rules_evaluated": {
          "minimum": 0,
          "type": "integer"
        },
        "units": {
          "$ref": "#/$defs/outcomeCounts",
          "description": "Over every evaluation unit, passes included."
        },
        "waived": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "by_severity",
        "by_status",
        "failing",
        "findings",
        "rules_evaluated",
        "units",
        "waived"
      ],
      "type": "object"
    },
    "evaluated_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "exit_code_meanings": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "expired_waivers": {
      "items": {
        "$ref": "#/$defs/waiver"
      },
      "type": "array"
    },
    "failure_kind": {
      "description": "Why the evaluation did not happen. Null when it did. The five kinds are never collapsed into one another in this document, even though the process exit code for all of them is 2 — CI can only branch on a small integer.",
      "oneOf": [
        {
          "enum": [
            "usage",
            "policy_invalid",
            "run_unreadable",
            "contract_incompatible",
            "evaluation_error"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "description": "Deterministically ordered by (severity rank, rule id, subject key, scope rank, language, path, start line, callable row id, finding id). Every component is a property of the rule or of the artifact, never of the evaluation, so the order is stable across runs.",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "type": "array"
    },
    "not_evaluable": {
      "description": "Compact projection of the `not_evaluable` findings, cross-referenced by finding_id rather than duplicated. Reported as its own section so a rule that did not run can never be mistaken for a rule that passed.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "fails_the_build": {
            "type": "boolean"
          },
          "finding_id": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_meaning": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "subject_key": {
            "type": "string"
          }
        },
        "required": [
          "fails_the_build",
          "finding_id",
          "metric",
          "reason",
          "reason_meaning",
          "rule_id",
          "scope",
          "subject_key"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "evaluated_as_format_version": {
          "const": "2.0.0"
        },
        "expected_contracts": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "integrity_rule_count": {
          "minimum": 0,
          "type": "integer"
        },
        "metric_rule_count": {
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "description": "Null only on a failed evaluation, where no policy was loaded.",
          "type": [
            "object",
            "null"
          ]
        },
        "policy_document_format_version": {
          "description": "The version the source file declared. A v1 document accepted by `check` keeps `1.0.0` here, so the result never claims the author wrote a v2 policy they did not write.",
          "type": [
            "string",
            "null"
          ]
        },
        "thresholds_are_user_supplied": {
          "const": true
        }
      },
      "required": [
        "evaluated_as_format_version",
        "integrity_rule_count",
        "metric_rule_count",
        "name",
        "options",
        "policy_document_format_version",
        "thresholds_are_user_supplied"
      ],
      "type": "object"
    },
    "provenance": {
      "description": "Run-level contract provenance. Deliberately small: this document references the run, it does not duplicate it.",
      "type": "object"
    },
    "rules": {
      "description": "One entry per enabled rule with its outcome tally, so a rule that evaluated cleanly is visible without enumerating a finding for every unit that passed.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "evaluation_error": {
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "enum": [
              "integrity",
              "metric"
            ]
          },
          "metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "metric_source": {
            "description": "The persisted artifact field the metric is read from.",
            "type": [
              "string",
              "null"
            ]
          },
          "not_applicable": {
            "minimum": 0,
            "type": "integer"
          },
          "not_evaluable": {
            "minimum": 0,
            "type": "integer"
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "passed": {
            "minimum": 0,
            "type": "integer"
          },
          "rule_id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "violation",
              "warning",
              "info"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "units_evaluated": {
            "minimum": 0,
            "type": "integer"
          },
          "violated": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "domain",
          "evaluation_error",
          "kind",
          "metric",
          "metric_source",
          "not_applicable",
          "not_evaluable",
          "operator",
          "passed",
          "rule_id",
          "scope",
          "severity",
          "threshold",
          "units_evaluated",
          "violated"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run": {
      "additionalProperties": false,
      "description": "The evaluated run's identity and the contracts it declares. Null-valued on a failed evaluation.",
      "properties": {
        "artifact_schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_qualification": {
          "description": "CONTEXTUAL PROVENANCE ONLY. `archlens check` is a generic product command: it requires no benchmark_qualification.json, no representativeness verdict, no benchmark usability and no benchmark-of-record readiness, and nothing here moves a metric, a threshold, a status or a verdict. Null when the evaluation did not happen.",
          "type": [
            "object",
            "null"
          ]
        },
        "lifecycle": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_validation_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjects": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "artifact_schema_version",
        "benchmark_qualification",
        "lifecycle",
        "run_directory",
        "run_id",
        "run_status",
        "schema_validation_result",
        "subjects"
      ],
      "type": "object"
    },
    "scope_note": {
      "type": "string"
    },
    "status_meanings": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "waived_findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "type": "array"
    }
  },
  "required": [
    "archlens_version",
    "check_result_format_version",
    "completeness_meanings",
    "counts",
    "evaluated_at",
    "exit_code",
    "exit_code_meanings",
    "expired_waivers",
    "failure_kind",
    "failure_message",
    "findings",
    "not_evaluable",
    "policy",
    "provenance",
    "rules",
    "run",
    "scope_note",
    "status_meanings",
    "verdict",
    "waived_findings"
  ],
  "title": "ArchLens check result 1.0.0",
  "type": "object"
}
