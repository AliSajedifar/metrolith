    "analyzed_sha": {
      "pattern": "^([0-9a-f]{40})?$",
      "type": [
        "string",
        "null"
      ]
    },
    "annotation_types": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
