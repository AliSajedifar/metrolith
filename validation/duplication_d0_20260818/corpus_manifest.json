  "candidate_discovery_expectations": [
    {"construct": "callable bodies", "expected": "candidate", "coverage": "named functions, methods, constructors, nested/local callables, anonymous block callables, generators"},
    {"construct": "branch bodies", "expected": "candidate", "coverage": "if, else, language-equivalent branch blocks"},
    {"construct": "loop bodies", "expected": "candidate", "coverage": "for, while, async/range forms, Python loop-else"},
    {"construct": "exception bodies", "expected": "candidate", "coverage": "try, catch/except, else, finally"},
    {"construct": "switch/case bodies", "expected": "candidate", "coverage": "Java/JS switch, Python match, Go expression/type switch and select"},
    {"construct": "explicit executable scoped blocks", "expected": "candidate", "coverage": "Python with, Java synchronized/initializers, Go/JS statement blocks, JS class static block"},
    {"construct": "expressions", "expected": "excluded", "coverage": "lambda/concise arrow expressions and ordinary expressions"},
    {"construct": "single statements", "expected": "excluded", "coverage": "return, assignment, expression statement"},
    {"construct": "arbitrary statement windows", "expected": "excluded", "coverage": "only complete body lists may be selected"},
    {"construct": "module bodies", "expected": "excluded", "coverage": "program/module/source_file roots"},
    {"construct": "imports and declarations", "expected": "excluded", "coverage": "imports, types, fields, signatures, .pyi and .d.ts"},
    {"construct": "unsupported/generated content", "expected": "excluded", "coverage": "unsupported extension plus existing inventory exclusions"}
  ],
  "transformation_matrix": [
    {"variant": "exact_copy", "lexical_exact": "match", "structural": "match"},
    {"variant": "whitespace_comment_copy", "lexical_exact": "match", "structural": "match"},
    {"variant": "renamed", "lexical_exact": "no_match", "structural": "match"},
    {"variant": "literal_changed", "lexical_exact": "no_match", "structural": "match"},
    {"variant": "operator_changed", "lexical_exact": "no_match", "structural": "no_match"},
    {"variant": "statement_added", "lexical_exact": "no_match", "structural": "no_match"},
    {"variant": "statement_removed", "lexical_exact": "no_match", "structural": "no_match"},
    {"variant": "statement_reordered", "lexical_exact": "no_match", "structural": "no_match"}
  ],
